{
  "name": "sl2-map-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run tiles",
    "dev": "vite",
    "prebuild": "npm run tiles",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "tiles": "node scripts/build-tiles.js",
    "slice-map": "node scripts/slice-map.js --input \"%MAP_INPUT%\" --outDir \"map-source/tiles\" --tileSize 800 --subfolderSize 6 --quality 75",
    "regions:fetch": "node scripts/fetch-regions.js",
    "regions:place": "node scripts/place-regions.js",
    "regions:compose": "node scripts/compose-regions.js"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "sharp": "^0.33.5",
    "vite": "^5.0.0"
  }
}
